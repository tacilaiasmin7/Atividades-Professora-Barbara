<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="atv2.css">
    <link rel="stylesheet" href="//cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <style>
    .card-img-top {
        height: 300px;
        width: 100%;
        object-fit: contain;
        background-color: white;
    }
    </style>
</head>
<header class="bg-white py-4">
    <div class="container d-flex justify-content-center">
        <img src ="logo.jpg" alt="logo" style="height: 100px;">
    </div>
</header>
        <body class="bg-dark">
    <div class="container py-5">
        <h1 class= "text-center mb-4 text-light">Produtos da Loja</h1>
    <div class="row">
        
    <div class="col-md-4 mb-3">
    <div class="card">
                <img src="moletom.webp" class="card-img-top" alt="Moletom BGK" height="500px">
                <div class="card-body-text-center">
                <h5 class="card-title">Moletom BGK</h5>
                <h5 class="alert alert-info py-1" role="alert">R$ 349,90</h5>
    </div>
    </div>
    </div>
                <div class="col-md-4 mb-3">
                <div class="card">
                <img src="calca.webp" class="card-img-top" alt="Calça Moletom BGK" height="500px">
                <div class="card-body-text-center">
                <h5 class="card-title">Calça Moletom BGK</h5>
                <h5 class="alert alert-info py-1" role="alert">R$ 199,90</h5>
    </div>
    </div>
    </div>
                <div class="col-md-4 mb-3">
                <div class="card">
                <img src="balaclava.webp" class="card-img-top" alt="Balaclava BGK" height="500px">
                <div class="card-body-text-center">
                <h5 class="card-title">Balaclava BGK</h5>
                <h5 class="alert alert-info py-1" role="alert">R$ 89,90</h5>
    </div>
    </div>
    </div>
                <div class="col-md-4 mb-3">
                <div class="card">
                <img src="bermuda.webp" class="card-img-top" alt="Bermuda BGK" height="500px">
                <div class="card-body-text-center">
                <h5 class="card-title">Bermuda BGK</h5>
                <h5 class="alert alert-info py-1" role="alert">R$ 339,90</h5>
     </div>
    </div>
    </div>
                <div class="col-md-4 mb-3">
                <div class="card">
                <img src="blusa.webp" class="card-img-top" alt="Cropped BGK" height="500px">
                <div class="card-body-text-center">
                <h5 class="card-title">Cropped BGK</h5>
                <h5 class="alert alert-info py-1" role="alert">R$ 129,90</h5>
    </div>
    </div>
    </div>
                <div class="col-md-4 mb-3">
                <div class="card">
                <img src="saia.webp" class="card-img-top" alt="Mini Saia BGK" height="500px">
                <div class="card-body-text-center">
                <h5 class="card-title">Mini Saia BGK</h5>
                <h5 class="alert alert-info py-1" role="alert">R$ 299,90</h5>
    </div>
    </div>
    </div>
    </div>
    </div>


    <footer class="bg-white text-dark py-4 mt-auto">
        <div class="container text-center">
        <p>© BGK World — Todos os direitos reservados.</p>
        <a href="https://www.instagram.com/bgk.world/">Instagram</a>
        <a href="https://bgk.world/contato/">Contato</a>
        </div>
    </footer>

</body>
</html>
