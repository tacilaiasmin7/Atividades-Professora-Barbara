                <div class="card-body text-center">
                <h5 class="card-title">Cropped BGK</h5>
                <h5 class="alert alert-info py-1" role="alert">R$ 129,90</h5>
    </div>
    </div>
    </div>
                <div class="col-md-4 mb-3">
